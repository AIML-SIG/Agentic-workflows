# Copy to .env (gitignored) and fill in for local devcontainer testing.
# Not needed for real GitHub Codespaces -- set this as a Codespaces secret
# instead (github.com/settings/codespaces, or repo Settings > Secrets and
# variables > Codespaces), which is injected the same way without a file.
#
# When using this (API-key auth) instead of an OAuth login, add --bare to
# AGENT_CMD -- required per pharmbench/README.md to stop the host's
# CLAUDE.md/memory from leaking into the agent.
ANTHROPIC_API_KEY=

# For the pi harness (https://pi.dev) routed through OpenRouter, e.g.
# AGENT_CMD='pi -p --provider openrouter --model <id>'
OPENROUTER_API_KEY=
