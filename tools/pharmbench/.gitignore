# Generated by score.R next to whatever submission it's pointed at -- a
# nuisance when that happens to be inside the repo (e.g. the documented
# smoke test against evals/submission.example.yaml). results/<run>/scorecard.yaml
# (written by --record) is a different, intentionally-tracked location --
# excluded from this rule below.
scorecard.yaml
!results/*/scorecard.yaml
